# TRANSPETRO — variáveis de ambiente
#
# Copie este arquivo para .env.local e preencha com os valores REAIS do seu projeto Supabase
# (Project Settings -> API, no painel do Supabase). NUNCA versione .env.local nem cole valores
# reais aqui neste arquivo de exemplo.
#
# IMPORTANTE: gere/configure suas próprias credenciais para este projeto. Nunca copie valores
# de um arquivo .env de outro projeto (ex.: ENSITEC) por atalho, mesmo que seja a mesma conta.

# URL do projeto Supabase (pública — pode ir ao navegador)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Chave "anon" / "publishable" do Supabase (pública — protegida pelas políticas RLS, não pela chave)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Chave "service_role" do Supabase — SECRETA. NUNCA prefixar com NEXT_PUBLIC_, NUNCA usar no
# navegador. Só é necessária se algum script administrativo de servidor precisar dela.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Chave da API da OpenAI (Professor TRANSPETRO) — SECRETA. Usada só em rotas de servidor
# (src/app/api/professor/*). NUNCA prefixar com NEXT_PUBLIC_, NUNCA referenciar em código de cliente.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
